#!/bin/sh
# Blocks commits containing game binaries/assets or oversized files, badly formatted C++ and
# Python lint errors. Enable once per clone: git config core.hooksPath .githooks
python=python
command -v python >/dev/null 2>&1 || python=python3 # Linux/macOS often ship only python3
"$python" tools/check_repo.py --staged || exit 1
"$python" tools/format.py --check || {
	echo "pre-commit: run 'python tools/format.py' to fix formatting" >&2
	exit 1
}
for ruff in .venv/Scripts/ruff.exe .venv/bin/ruff ruff; do
	command -v "$ruff" >/dev/null 2>&1 && break
done
"$ruff" check -q tools || {
	echo "pre-commit: ruff failed (missing? run 'uv sync')" >&2
	exit 1
}
